{
  "manifest_version": 3,
  "name": "微信公众号HTML编辑助手",
  "version": "1.0.1",
  "description": "在微信公众号编辑器中增加HTML源码模式和AI排版优化侧边栏",
  "icons": {
    "16": "icon/icon-16.png",
    "32": "icon/icon-32.png",
    "48": "icon/icon-48.png",
    "128": "icon/icon-128.png"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://mp.weixin.qq.com/*",
    "https://api.anthropic.com/*",
    "https://api.moonshot.cn/*",
    "https://api.kimi.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mp.weixin.qq.com/cgi-bin/appmsg*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon/icon-16.png",
      "32": "icon/icon-32.png"
    }
  }
}
